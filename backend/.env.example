# Скопируйте этот файл в .env и заполните

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-ваш-токен

# Telegram ID администраторов через запятую (узнать свой: отправьте боту /myid)
ADMIN_IDS=123456789

# Куда присылать заказы: ID админа или группы (для группы ID начинается с -100...).
# Если пусто — заказы придут первому админу из ADMIN_IDS
ORDER_CHAT_ID=

# Менеджер для кнопки «Спросить у менеджера» (без @)
ADMIN_USERNAME=Jakhan_11

CHANNEL_URL=https://t.me/elta_uz
PHONES=+998(33)003-22-77,+998(93)516-05-38

# Как часто подтягивать новые товары из канала (в часах, 0 = выключить)
AUTO_UPDATE_HOURS=6

# --- Мини-приложение (Web App) ---
# Постоянный https-адрес магазина (на сервере с доменом). Если пусто — бот сам поднимет
# временный адрес через cloudflared (меняется при каждом перезапуске, кнопка обновится сама).
WEBAPP_URL=
# auto — поднимать временный туннель cloudflared, off — не поднимать
TUNNEL=auto
WEB_PORT=8080

# База Neon (PostgreSQL) для заказов и корзин: строка подключения из console.neon.tech → Connect.
# Пусто — заказы и корзины хранятся только в файлах data/*.json
DATABASE_URL=
